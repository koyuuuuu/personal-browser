  "apps": [
    {
      "name": "Personal Browser",
      "bundleIdentifier": "local.personalbrowser.app",
      "developerName": "Personal Browser",
      "localizedDescription": "自分専用のブラウザ。タブ、履歴、ブックマーク、プライベート閲覧、UIカスタマイズに対応。",
      "iconURL": "https://raw.githubusercontent.com/koyuuuuu/personal-browser-distribution/main/icon.png",
      "versions": [
        {
          "version": "0.14.0",
          "buildVersion": "86",
          "date": "2026-11-11T01:03:16.084069+00:00",
          "localizedDescription": "設定で有効にすると横に傾けたとき動画を自動全画面にし、横長は横向き、縦長・正方形は縦向きで表示します。一時停止を維持し、終了時は通常の向きに戻します。サイトやiOSの制限により手動操作が必要な場合があります。タブ一覧が画面回転後に1列になる不具合も修正。",
          "downloadURL": "https://github.com/koyuuuuu/personal-browser-distribution/releases/download/v0.14.0-build.86/PersonalBrowser.ipa",
          "size": 5716100,
          "minOSVersion": "17.0",
          "sha256": "fbd819a01c45116a3ad15e52788530ed97347c6e33b249b1e149b5abf9ef3414"
        },
        {
          "version": "0.13.0",
          "buildVersion": "80",
          "date": "2026-11-10T17:36:21.684877+00:00",
          "localizedDescription": "ログイン欄を選ぶとキーボード直上の1行候補から保管庫のパスワードを直接入力できます。ロック中も認証後に入力し、管理画面への移動は不要。フォーム送信時に新しいパスワードの保存や既存アカウントの更新を自動で提案し、確認して確定できます。Apple標準の候補と既存の暗号化保管庫を維持。",
          "downloadURL": "https://github.com/koyuuuuu/personal-browser-distribution/releases/download/v0.13.0-build.80/PersonalBrowser.ipa",
          "size": 5672347,
          "minOSVersion": "17.0",
          "sha256": "7a2d8d0ce82410651bae03922fa502cbf64923362681d6b38b9f41c17863d97a"
        },
        {
          "version": "0.12.1",
          "buildVersion": "72",
          "date": "2026-11-09T19:10:47.973873+00:00",
          "localizedDescription": "0.12.0で画面が真っ暗になり下部ツールバーが画面外へずれる不具合を修正。検証用UIを配布版のレイアウトから除外し、パスワード候補欄とWeb表示領域の高さを明示的に分配。ブックマーク・履歴・設定・保管庫を維持。",
          "downloadURL": "https://github.com/koyuuuuu/personal-browser-distribution/releases/download/v0.12.1-build.72/PersonalBrowser.ipa",
          "size": 5627491,
          "minOSVersion": "17.0",
          "sha256": "549436452fc986159e4b6ccf13732b8b9a2f80fcc476dac11be36a61c6b749b6"
        },
        {
          "version": "0.12.0",
          "buildVersion": "70",
          "date": "2026-11-09T16:41:20.117584+00:00",
          "localizedDescription": "ログインページの下部にApple標準パスワードへの入口とブラウザ保管庫のアカウント候補を追加。フォームの自動入力属性を補助し、ユーザー名だけのログイン段階にも対応。保管庫解除中・一致する候補とフォームが各1件・未入力の通常タブだけ、確認なしで入力する任意設定を追加（初期オフ）。Appleの認証を省略せず、ログイン送信・入力済み内容の上書きを行いません。既存データ・暗号化保管庫を維持。",
          "downloadURL": "https://github.com/koyuuuuu/personal-browser-distribution/releases/download/v0.12.0-build.70/PersonalBrowser.ipa",
          "size": 5626380,
          "minOSVersion": "17.0",
          "sha256": "4c85a9f591483297b082847cb62a46058351c7a69ffd15a7efe1661379e8014d"
        },
        {
          "version": "0.11.0",
          "buildVersion": "65",
          "date": "2026-11-08T07:51:24.792322+00:00",
          "localizedDescription": "端末認証付きの暗号化パスワード保管庫を追加。Safari・BraveのCSV／Safari ZIPから専用画面で取り込み、サイト・ポート・証明書を照合して選択したログインフォームに入力。自動送信なし、プライベート入力は初期オフ。編集・削除・自動ロック設定とパスフレーズ付き暗号化バックアップに対応。既存の閲覧データとAppleのパスワードは維持。",
          "downloadURL": "https://github.com/koyuuuuu/personal-browser-distribution/releases/download/v0.11.0-build.65/PersonalBrowser.ipa",
          "size": 5585851,
          "minOSVersion": "17.0",
          "sha256": "1ab5cfbf67ae2e498175b55c243c69070a28cccbfaac74583e6ed21f0433c313"
        },
        {
          "version": "0.10.1",
          "buildVersion": "60",
          "date": "2026-11-03T16:45:06.237099+00:00",
          "localizedDescription": "スクロールを止めるページでも指の上下操作でバーを復帰。読込失敗・表示プロセス終了時はバーと再読込・タブ一覧を表示し、安全な要求だけ回数制限付きで自動復旧。Reddit等のアプリ誘導を軽減する任意設定とReddit旧Web表示へのメニューを追加。データ・再生方式を維持。",
          "downloadURL": "https://github.com/koyuuuuu/personal-browser-distribution/releases/download/v0.10.1-build.60/PersonalBrowser.ipa",
          "size": 5387661,
          "minOSVersion": "17.0",
          "sha256": "976757cfab7981ddc12f2d54b6bcd3b2925d0f4a5219cd9ee789687219ec2d93"
        },
        {
          "version": "0.10.0",
          "buildVersion": "58",
          "date": "2026-11-01T20:19:19.383568+00:00",
          "localizedDescription": "メニューに音声ミキサーを追加。検出できたページ内音声・動画を個別ミュートし、対応する直接ファイルは明示的なCORS再読込後に音源ごとの音量を調整できます。Blob・MSE・DRM・ネイティブ画面や他アプリの音量は対象外です。既存の再生方式、タブや保存済みデータを維持します。",
          "downloadURL": "https://github.com/koyuuuuu/personal-browser-distribution/releases/download/v0.10.0-build.58/PersonalBrowser.ipa",
          "size": 5355711,
          "minOSVersion": "17.0",
          "sha256": "d49710e3b6a303b41c90462f43aa74ecca4e28189b6aeddf29085081c1f331bc"
        },
        {
          "version": "0.9.0",
          "buildVersion": "52",
          "date": "2026-10-31T10:10:26.200032+00:00",
          "localizedDescription": "設定に音声の同時再生モードを追加。再生前のmixWithOthers準備と対応Web音声の非排他セッション要求を個別に切替可能。再生中タブの保持を補強し、既存の再生方式とデータを維持。YouTube・DRM・全画面・他アプリ等の排他制御による制限は残り、全組合せの同時再生は保証しません。",
          "downloadURL": "https://github.com/koyuuuuu/personal-browser-distribution/releases/download/v0.9.0-build.52/PersonalBrowser.ipa",
          "size": 5305902,
          "minOSVersion": "17.0",
          "sha256": "1608c4338c8c1e7ad13c1cc4f2ea2edbcfaed82ec49ae749828f37b06d2ff11c"
        },
        {
          "version": "0.8.0",
          "buildVersion": "46",
          "date": "2026-10-30T03:32:58.793517+00:00",
          "localizedDescription": "選択テキストを自作ブラウザの新規タブでWeb検索。標準選択メニューの追加項目と、WebKitで表示できない場合の画面内検索ボタンに対応。mybrowser://search?text= でショートカットから共有テキストを検索。既存のURL受信・保存データ・検索エンジン設定を維持し、新規利用時の初期検索エンジンはGoogle。",
          "downloadURL": "https://github.com/koyuuuuu/personal-browser-distribution/releases/download/v0.8.0-build.46/PersonalBrowser.ipa",
          "size": 5285612,
          "minOSVersion": "17.0",
          "sha256": "54e290c069d29ae06eeafee4c33adaa964f99aae55c38b959a83a3b2f5b9c8bf"
        },
        {
          "version": "0.7.0",
          "buildVersion": "45",
          "date": "2026-10-28T13:31:51.614384+00:00",
          "localizedDescription": "リンク・メニュー・ポップアップの新規タブを元のタブの隣へ配置。ツールバーとタブ一覧の＋は末尾追加を維持。タブを見ていた順に何段階も戻る・進むボタンを通常ツールバーとアドレスバー左右へ追加可能に。閉じたタブを飛ばし、プライベートの閲覧順は保存しません。旧版向けのボタン設定・既存データ形式を維持。",
          "downloadURL": "https://github.com/koyuuuuu/personal-browser-distribution/releases/download/v0.7.0-build.45/PersonalBrowser.ipa",
          "size": 5274341,
          "minOSVersion": "17.0",
          "sha256": "bf172c54772a798c4e640bcdd3d5f7368ba785a8179ad125ee646c7b1b3164d7"
        },
        {
          "version": "0.6.0",
          "buildVersion": "42",
          "date": "2026-10-27T04:38:24.029478+00:00",
          "localizedDescription": "更新可能なEasyList・EasyPrivacy・日本語フィルターによる広告ブロックへ強化。標準／強力、広告枠の非表示、自動・手動更新、ライセンス表示を追加。お気に入りはサイト独自のアイコンを取得・保存し、取得不可時は頭文字を表示。既存データとbuild14の再生方針を維持。",
          "downloadURL": "https://github.com/koyuuuuu/personal-browser-distribution/releases/download/v0.6.0-build.42/PersonalBrowser.ipa",
          "size": 5263165,
          "minOSVersion": "17.0",
          "sha256": "81fe9e7f82e423dc3c8cca599dc88648a960d083c15b45b0b639272884af794b"
        },
        {
          "version": "0.5.0",
          "buildVersion": "38",
          "date": "2026-10-25T20:10:12.317833+00:00",
          "localizedDescription": "0.4.2 build 27を復帰基準として保持。お気に入りのホームでのドラッグ配置と設定からの編集、サイトごとのアプリ連携選択、検索結果での検索語表示・再検索、軽量なタブ遷移と灰色の狭い隙間、mybrowser URLスキームによる外部共有リンクの新規タブ受信を追加。 ホーム画面の検索候補を設定で切替（初期オフ）。",
          "downloadURL": "https://github.com/koyuuuuu/personal-browser-distribution/releases/download/v0.5.0-build.38/PersonalBrowser.ipa",
          "size": 992118,
          "minOSVersion": "17.0",
          "sha256": "695f90d84ec04ec5f793b2dd55387eceab6b72fd5e0aacfb592ced13691d2a5f"
        },
        {
          "version": "0.4.2",
          "buildVersion": "27",
          "date": "2026-10-25T07:14:58.042834+00:00",
          "localizedDescription": "タブ一覧をネイティブのグリッドに変更し、削除判定と同時に周囲のタブを移動。アドレスバーのスワイプに指に追従する遷移を追加。横画面ホームの操作領域を修正。午前・午後別の履歴と個別・一括削除、履歴からのアドレス候補、5％刻みの倍率ボタン、Safari取り込みの文字参照・文字コード対応を追加。縦横のバーをスクロール方向で表示し、最下部の跳ね返りでの誤表示を防止。",
          "downloadURL": "https://github.com/koyuuuuu/personal-browser-distribution/releases/download/v0.4.2-build.27/PersonalBrowser.ipa",
          "size": 916001,
          "minOSVersion": "17.0",
          "sha256": "3d3477697c89d15cd3cc955c442b486bee65ccd62917195f2ef130cc5e75a4ad"
        },
        {
          "version": "0.4.1",
          "buildVersion": "24",
          "date": "2026-10-24T22:25:56.219443+00:00",
          "localizedDescription": "タブ削除後の待機時間とページの横スライドを廃止。タブ画像の幅制限・取得中の表示保持を修正し、黒い画像の上書きと横画面の表示崩れを防止。縦画面バーの寸法・安全領域と再生制御をbuild 14へ戻しました。バー復帰矢印を削除し、下方向スワイプで再表示。",
          "downloadURL": "https://github.com/koyuuuuu/personal-browser-distribution/releases/download/v0.4.1-build.24/PersonalBrowser.ipa",
          "size": 844562,
          "minOSVersion": "17.0",
          "sha256": "b7d265a110775baf04a42772459f35affd0fd69936113aa499b35c373c815b8b"
        },
        {
          "version": "0.4.0",
          "buildVersion": "20",
          "date": "2026-10-24T21:00:41.015676+00:00",
          "localizedDescription": "横画面のバーを自動的に隠し、上側へ戻るスクロールで細い1行バーを表示。縦横のバー非表示、アドレスバー左右のボタン編集、タブの列数・文字サイズ・ページ倍率、背景の位置・ズーム調整を追加。通常タブの画像を再起動後も保存し、一覧をアクティブタブの位置で開くように変更。下部の＋で直接新規タブを追加し、末尾スワイプでも新規作成。タブ切替・削除のアニメーションを改善。バックグラウンド音声を優先し、ホームインジケータに自動非表示を要求。接続確認と、チェックした場合だけ保存する接続先・証明書別の例外、ローカルHTTPへの切替確認を追加。既存のブックマーク・履歴形式とアプリIDを維持。",
          "downloadURL": "https://github.com/koyuuuuu/personal-browser-distribution/releases/download/v0.4.0-build.20/PersonalBrowser.ipa",
          "size": 858640,
          "minOSVersion": "17.0",
          "sha256": "0fec29654dd75e5311b9bc0da215e496c0e3a5561fdd965be2bc42846951f31f"
        },
        {
          "version": "0.3.0",
          "buildVersion": "14",
          "date": "2026-10-24T17:23:50.712572+00:00",
          "localizedDescription": "PiPのバックグラウンド再生設定と共有シートを修正。広告ブロック・サイト別除外、500タブの遅延読み込み、タイル式一覧とスワイプ操作、お気に入りホーム・背景画像、ブックマークフォルダ、リンク長押しメニュー、ページ内検索・ダウンロード・HTML/CSV/JSON取り込みと書き出しを追加。既存のブックマーク・履歴形式とアプリIDを維持。PiPと上書き更新は実機で受け入れ確認が必要です。 SafariのZIP書き出しに対応し、パスワードはApple標準の管理機能を継続利用。YouTube・ブラウザ・ファイル保存・メール・メッセージ等のリンク操作と、Watch HTMLへのURL引き渡しを追加。",
          "downloadURL": "https://github.com/koyuuuuu/personal-browser-distribution/releases/download/v0.3.0-build.14/PersonalBrowser.ipa",
          "size": 696060,
          "minOSVersion": "17.0",
